# Only replication code, evidence and its instructions are versioned here.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/REPLICATION_GUIDE.md
!/THESIS_RESULT_MAP.md
!/THESIS_RESULT_MAP.json
!/scripts/
!/replication/
!/data/

# Generated documents are not versioned.
*.pdf
*.tex
*.sty

# Runtime caches and build products are regenerated locally.
.DS_Store
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.*
.aws/
.ssh/
.cache/
__pycache__/
*.pyc
*.o
*.mod
*.smod
*.a
*.exe
*.aux
*.log
*.toc
*.out
*.lot
*.lof
*.synctex.gz
*.fdb_latexmk
*.fls
*.bak
*.zip
*.dta
# These are the three official public SCF archives used by the thesis.
!data/scf2022/*.zip
data/scf2022/extracted/
data/scf2022/generated/
reproduction_runs/
**/Bench_Files/
**/Exp_Files/
**/Compiled_Files_Baseline/
replication/runtime/
replication/paper_python/outputs/
replication/output/
